# ----------------------------------------------------------------------
#  Borland MAKE rules for Oregon Trail reconstruction.
#  Targets Turbo Pascal 6.0 (tpc.exe).
# ----------------------------------------------------------------------

TPC = tpc
FLAGS = /m /$O+ /$D-

UNITS = GAMETYPE.TPU GAMESTAT.TPU RNG.TPU LANDMARK.TPU ILLNESS.TPU \
        EVENTS.TPU UI.TPU STORE.TPU RIVER.TPU HUNTING.TPU \
        GRAPHX.TPU MUSIC.TPU DIALOGS.TPU SAVELOAD.TPU TRAVEL.TPU

all : OREGON.EXE

OREGON.EXE : OREGON.PAS $(UNITS)
	$(TPC) $(FLAGS) OREGON.PAS

# Unit build order respects "uses" graph.

GAMETYPE.TPU : GAMETYPE.PAS
	$(TPC) $(FLAGS) GAMETYPE.PAS

RNG.TPU : RNG.PAS
	$(TPC) $(FLAGS) RNG.PAS

GAMESTAT.TPU : GAMESTAT.PAS GAMETYPE.TPU
	$(TPC) $(FLAGS) GAMESTAT.PAS

LANDMARK.TPU : LANDMARK.PAS GAMETYPE.TPU
	$(TPC) $(FLAGS) LANDMARK.PAS

ILLNESS.TPU : ILLNESS.PAS GAMETYPE.TPU RNG.TPU GAMESTAT.TPU
	$(TPC) $(FLAGS) ILLNESS.PAS

EVENTS.TPU : EVENTS.PAS GAMETYPE.TPU RNG.TPU GAMESTAT.TPU ILLNESS.TPU
	$(TPC) $(FLAGS) EVENTS.PAS

UI.TPU : UI.PAS GAMETYPE.TPU GAMESTAT.TPU
	$(TPC) $(FLAGS) UI.PAS

STORE.TPU : STORE.PAS GAMETYPE.TPU GAMESTAT.TPU
	$(TPC) $(FLAGS) STORE.PAS

RIVER.TPU : RIVER.PAS GAMETYPE.TPU RNG.TPU GAMESTAT.TPU STORE.TPU
	$(TPC) $(FLAGS) RIVER.PAS

HUNTING.TPU : HUNTING.PAS GAMETYPE.TPU RNG.TPU GAMESTAT.TPU
	$(TPC) $(FLAGS) HUNTING.PAS

GRAPHX.TPU : GRAPHX.PAS
	$(TPC) $(FLAGS) GRAPHX.PAS

MUSIC.TPU : MUSIC.PAS
	$(TPC) $(FLAGS) MUSIC.PAS

DIALOGS.TPU : DIALOGS.PAS GAMETYPE.TPU RNG.TPU
	$(TPC) $(FLAGS) DIALOGS.PAS

SAVELOAD.TPU : SAVELOAD.PAS GAMETYPE.TPU GAMESTAT.TPU
	$(TPC) $(FLAGS) SAVELOAD.PAS

TRAVEL.TPU : TRAVEL.PAS GAMETYPE.TPU GAMESTAT.TPU UI.TPU RNG.TPU \
             EVENTS.TPU ILLNESS.TPU LANDMARK.TPU RIVER.TPU STORE.TPU \
             HUNTING.TPU SAVELOAD.TPU DIALOGS.TPU MUSIC.TPU
	$(TPC) $(FLAGS) TRAVEL.PAS

clean :
	del *.TPU
	del OREGON.EXE
